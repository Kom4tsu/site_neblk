    <a href="/admin/pedidos" class="<%= currentPath === '/admin/pedidos' ? 'active' : '' %>">▤ Pedidos</a>
    <a href="/admin/metricas" class="<%= currentPath === '/admin/metricas' ? 'active' : '' %>">⌁ Métricas</a>
