  <nav>
    <a href="/admin/dashboard" class="<%= currentPath === '/admin/dashboard' ? 'active' : '' %>">◈ Dashboard</a>
    <a href="/admin/produtos" class="<%= currentPath.startsWith('/admin/produtos') ? 'active' : '' %>">▣ Produtos</a>
