<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<%- include('../partials/flash') %>

<main id="main-content" class="auth-page">
  <section class="auth-card">
    <p class="eyebrow">NOVO POR AQUI?</p>
    <h1>CRIAR <em>CONTA</em></h1>
    <p class="muted">Seu acesso à NEBLK começa aqui.</p>
    
    <form method="post" action="/cadastro" class="form-stack">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Nome completo
        <input name="name" required autocomplete="name" placeholder="Seu nome">
      </label>
      <label>E-mail
        <input name="email" type="email" required autocomplete="email" placeholder="voce@email.com">
      </label>
      <label>WhatsApp
        <input name="phone" autocomplete="tel" placeholder="(00) 00000-0000">
      </label>
      <label>Senha
        <input name="password" type="password" minlength="8" required autocomplete="new-password" placeholder="Mínimo de 8 caracteres">
      </label>
      <button class="button button-primary wide" type="submit">CRIAR CONTA ↗</button>
    </form>

    <!-- Início do Bloco de Login Social -->
    <div class="social-login" style="margin-top: 24px; margin-bottom: 24px; display: flex; flex-direction: column; gap: 12px;">
      <div style="text-align: center; color: #888; font-size: 0.9em;">ou continue com</div>
      <a href="/auth/google" class="button button-secondary wide" style="display: flex; align-items: center; justify-content: center; gap: 8px;">
        <span>Entrar com Google</span>
      </a>
      <a href="/auth/github" class="button button-secondary wide" style="display: flex; align-items: center; justify-content: center; gap: 8px;">
        <span>Entrar com GitHub</span>
      </a>
    </div>
    <!-- Fim do Bloco de Login Social -->

    <p class="auth-switch">Já tem conta? <a href="/login">ENTRAR</a></p>
  </section>
</main>

<%- include('../partials/footer') %>