<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<%- include('../partials/flash') %>

<main id="main-content" class="auth-page">
  <section class="auth-card">
    <p class="eyebrow">BEM-VINDO DE VOLTA</p>
    <h1>ENTRAR NA <em>NEBLK</em></h1>
    <p class="muted">Acompanhe seus pedidos e entre nos próximos drops primeiro.</p>
    
    <form method="post" action="/login" class="form-stack">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="next" value="<%= nextUrl %>">
      <label>E-mail
        <input name="email" type="email" required autocomplete="email" placeholder="voce@email.com">
      </label>
      <label>Senha
        <input name="password" type="password" required autocomplete="current-password" placeholder="••••••••">
      </label>
      <p class="forgot-password"><a href="/esqueci-senha">ESQUECI MINHA SENHA</a></p>
      <button class="button button-primary wide" type="submit">ENTRAR ↗</button>
    </form>

    <!-- Início do Bloco de Login Social -->
    <div class="social-login" style="margin-top: 24px; margin-bottom: 24px; display: flex; flex-direction: column; gap: 12px;">
      <div style="text-align: center; color: #888; font-size: 0.9em;">ou continue com</div>
      <a href="/auth/google" class="button button-secondary wide" style="display: flex; align-items: center; justify-content: center; gap: 8px;">
        <span>Entrar com Google</span>
      </a>
      <a href="/auth/github" class="button button-secondary wide" style="display: flex; align-items: center; justify-content: center; gap: 8px;">
        <span>Entrar com GitHub</span>
      </a>
    </div>
    <!-- Fim do Bloco de Login Social -->

    <p class="auth-switch">Ainda não tem conta? <a href="/cadastro">CRIAR MINHA CONTA</a></p>
  </section>
</main>

<%- include('../partials/footer') %>