<%- include('../partials/head') %>
<%- include('../partials/flash') %>
<main class="admin-login-page" id="main-content">
  <div class="admin-login-noise"></div>
  <a href="<%= publicUrl %>" class="admin-login-back">← VOLTAR À LOJA</a>
  <section class="admin-login-card">
    <div class="admin-login-brand"><img src="/assets/brand/neblk-mark.svg" alt="NEBLK"><span>NEBLK<br><small>ADMIN ACCESS</small></span></div>
    <p class="eyebrow">ÁREA RESTRITA</p>
    <h1>CONTROL<br>THE <em>DROP.</em></h1>
    <p class="muted">Acesso exclusivo para gestão da NEBLK.</p>
    <form method="post" action="/login" class="form-stack">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="next" value="<%= nextUrl || '/admin/dashboard' %>">
      <label>E-mail administrativo<input name="email" type="email" required autocomplete="email" placeholder="admin@neblk.com.br"></label>
      <label>Senha<input name="password" type="password" required autocomplete="current-password" placeholder="••••••••"></label>
      <button class="button button-primary wide" type="submit">ENTRAR NO PAINEL <span>↗</span></button>
    </form>
    <p class="admin-login-lock">◈ Área monitorada e protegida por autenticação.</p>
  </section>
</main>
<script src="/js/app.js" defer></script>
</body>
</html>
