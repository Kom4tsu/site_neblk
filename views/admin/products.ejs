<%- include('../partials/head') %>
<div class="admin-shell"><%- include('../partials/admin-nav') %><main class="admin-main" id="main-content"><% const adminTitle = 'Produtos'; %><%- include('../partials/admin-top', { adminTitle }) %><%- include('../partials/flash') %><div class="admin-page-actions"><div><p class="muted">Gerencie catálogo, estoque, fotos e visibilidade de cada peça.</p></div><a href="/admin/produtos/novo" class="button button-primary">+ NOVO PRODUTO</a></div><section class="admin-panel table-panel"><div class="table-scroll"><table class="admin-table"><thead><tr><th>Produto</th><th>Coleção</th><th>Preço</th><th>Estoque</th><th>Visualizações</th><th>Vendas</th><th>Status</th><th></th></tr></thead><tbody><% products.forEach((product) => { %><tr><td class="table-product"><img src="<%= product.image_url || '/assets/products/shadow-logo.svg' %>" alt=""><strong><%= product.name %></strong></td><td><%= product.collection_name %></td><td><%= formatCurrency(product.price_cents) %></td><td><%= product.total_stock %></td><td><%= product.view_count %></td><td><%= product.sold_count %></td><td><span class="status <%= product.is_active ? 'status-entregue' : 'status-cancelado' %>"><%= product.is_active ? 'Ativo' : 'Arquivado' %></span></td><td><a href="/admin/produtos/<%= product.id %>/editar" class="table-action">EDITAR ↗</a></td></tr><% }) %></tbody></table></div></section></main><%- include('../partials/admin-end') %>
