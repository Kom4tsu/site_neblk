<%- include('../partials/head') %>
<div class="admin-shell"><%- include('../partials/admin-nav') %><main class="admin-main" id="main-content"><% const adminTitle = product ? 'Editar produto' : 'Novo produto'; %><%- include('../partials/admin-top', { adminTitle }) %><%- include('../partials/flash') %><div class="admin-page-actions"><a href="/admin/produtos" class="text-link">← VOLTAR A PRODUTOS</a><% if (product && product.is_active) { %><form action="/admin/produtos/<%= product.id %>/arquivar" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="button button-danger">ARQUIVAR PRODUTO</button></form><% } %></div><form class="product-admin-form" method="post" enctype="multipart/form-data" action="<%= product ? `/admin/produtos/${product.id}` : '/admin/produtos' %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-section"><p class="eyebrow">IDENTIDADE DA PEÇA</p><div class="form-grid"><label>Nome do produto<input name="name" required value="<%= product ? product.name : '' %>" placeholder="Ex.: Oversized Purple Web"></label><label>Preço (R$)<input name="price" required inputmode="decimal" value="<%= product ? (product.price_cents / 100).toFixed(2).replace('.', ',') : '' %>" placeholder="159,90"></label><label>Preço de referência (opcional)<input name="compare_at" inputmode="decimal" value="<%= product && product.compare_at_cents ? (product.compare_at_cents / 100).toFixed(2).replace('.', ',') : '' %>" placeholder="179,90"></label><label>Categoria<input name="category" required value="<%= product ? product.category : 'Camisetas' %>" placeholder="Camisetas"></label><label>Drop / coleção<select name="collection_name" required><% (drops || []).forEach((drop) => { %><option value="<%= drop.name %>" <%= (product ? product.collection_name : 'Drop 01') === drop.name ? 'selected' : '' %>><%= drop.name %></option><% }) %></select><small>Cadastre novos drops no menu Admin → Drops.</small></label><label>Cor<input name="color" value="<%= product && product.variants.length ? product.variants[0].color : 'Preto' %>"></label></div><label>Descrição<textarea name="description" required rows="6" placeholder="Descreva tecido, caimento, proposta e detalhes."><%= product ? product.description : '' %></textarea></label><div class="form-grid"><label>Variações e estoque <small>Formato: P:5, M:10, G:8, GG:3</small><input name="variants" required value="<%= product ? product.variants.map((variant) => `${variant.size}:${variant.stock}`).join(', ') : 'P:0, M:0, G:0, GG:0' %>"></label><div class="check-row"><label class="check-label"><input type="checkbox" name="is_featured" <%= !product || product.is_featured ? 'checked' : '' %>><span>Exibir em destaque</span></label><label class="check-label"><input type="checkbox" name="is_active" <%= !product || product.is_active ? 'checked' : '' %>><span>Produto ativo na loja</span></label></div></div></div><div class="form-section"><p class="eyebrow">FOTOS</p><p class="muted">Envie JPG, PNG ou WEBP de até 5 MB. A primeira foto será a imagem de capa.</p><label class="upload-zone"><input type="file" name="images" accept="image/jpeg,image/png,image/webp" multiple><span>＋</span><strong>ADICIONAR FOTOS</strong><small>Você pode selecionar até 8 arquivos por envio.</small></label><% if (product && product.images.length) { %><div class="admin-image-grid"><% product.images.forEach((image) => { %><label class="admin-image"><img src="<%= image.image_url %>" alt=""><span><input type="checkbox" name="remove_image_ids" value="<%= image.id %>"> Remover</span></label><% }) %></div><% } %></div><div class="form-submit"><button type="submit" class="button button-primary"><%= product ? 'SALVAR ALTERAÇÕES' : 'PUBLICAR PRODUTO' %> ↗</button></div></form></main><%- include('../partials/admin-end') %>
