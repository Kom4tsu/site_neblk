<%- include('../partials/head') %>
<div class="admin-shell"><%- include('../partials/admin-nav') %><main class="admin-main" id="main-content"><% const adminTitle = 'Métricas'; %><%- include('../partials/admin-top', { adminTitle }) %><%- include('../partials/flash') %><section class="metric-grid"><article class="metric-card"><span>VISUALIZAÇÕES</span><strong><%= metrics.views %></strong><small>No mês atual</small></article><article class="metric-card"><span>CLIENTES</span><strong><%= metrics.customers %></strong><small>Cadastros totais</small></article><article class="metric-card"><span>RECEITA EM PEDIDOS</span><strong><%= formatCurrency(metrics.revenue) %></strong><small>Pedidos não cancelados</small></article><article class="metric-card"><span>CONVERSÃO INDICATIVA</span><strong><%= metrics.views ? ((metrics.orders / metrics.views) * 100).toFixed(1) : '0.0' %>%</strong><small>Pedidos / visualizações</small></article></section><section class="admin-panel sales-panel"><div class="panel-heading"><div><span class="eyebrow">RITMO DE VENDA</span><h2>FATURAMENTO POR DIA</h2></div></div><div class="sales-chart large-chart" data-sales-chart='<%- chartData %>'><div class="chart-bars"></div><div class="chart-labels"></div></div></section><section class="admin-columns"><article class="admin-panel"><div class="panel-heading"><div><span class="eyebrow">DESEJO</span><h2>MAIS VISUALIZADOS</h2></div></div><div class="ranking-list"><% metrics.topViewed.forEach((item, index) => { %><div class="ranking-row"><span class="rank">0<%= index + 1 %></span><img src="<%= item.image_url || '/assets/products/shadow-logo.svg' %>" alt=""><div><strong><%= item.name %></strong><small><%= item.views %> visualizações</small></div><a href="/produto/<%= item.slug %>" target="_blank">Ver</a></div><% }) %></div></article><article class="admin-panel"><div class="panel-heading"><div><span class="eyebrow">CONVERSÃO</span><h2>MAIS VENDIDOS</h2></div></div><div class="ranking-list"><% metrics.topSold.forEach((item, index) => { %><div class="ranking-row"><span class="rank">0<%= index + 1 %></span><img src="<%= item.image_url || '/assets/products/shadow-logo.svg' %>" alt=""><div><strong><%= item.name %></strong><small><%= item.units %> unidades · <%= formatCurrency(item.revenue) %></small></div><a href="/admin/produtos/<%= item.id %>/editar">Editar</a></div><% }) %></div></article></section><section class="admin-panel table-panel"><div class="panel-heading"><div><span class="eyebrow">CATÁLOGO</span><h2>VISUALIZAÇÕES X VENDAS</h2></div></div><div class="table-scroll"><table class="admin-table"><thead><tr><th>Produto</th><th>Visualizações</th><th>Unidades vendidas</th><th>Conversão</th><th></th></tr></thead><tbody><% products.forEach((product) => { %><tr><td class="table-product"><img src="<%= product.image_url || '/assets/products/shadow-logo.svg' %>" alt=""><strong><%= product.name %></strong></td><td><%= product.view_count %></td><td><%= product.sold_count %></td><td><%= product.view_count ? ((product.sold_count / product.view_count) * 100).toFixed(1) : '0.0' %>%</td><td><a href="/admin/produtos/<%= product.id %>/editar" class="table-action">EDITAR ↗</a></td></tr><% }) %></tbody></table></div></section></main><%- include('../partials/admin-end') %>
