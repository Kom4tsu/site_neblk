<%- include('../partials/head') %>
<div class="admin-shell"><%- include('../partials/admin-nav') %><main class="admin-main" id="main-content"><% const adminTitle = 'Pedidos'; %><%- include('../partials/admin-top', { adminTitle }) %><%- include('../partials/flash') %><div class="admin-page-actions"><p class="muted">Atualize a situação operacional e a confirmação de pagamento de cada venda.</p></div><section class="admin-panel table-panel"><div class="table-scroll"><table class="admin-table orders-table"><thead><tr><th>Pedido</th><th>Cliente</th><th>Data</th><th>Total</th><th>Status</th><th>Pagamento</th><th>Atualizar</th></tr></thead><tbody><% if (orders.length) { %><% orders.forEach((order) => { %><tr><td><strong><%= order.order_number %></strong><small><%= order.items_count %> item(ns)</small></td><td><strong><%= order.customer_name %></strong><small><%= order.customer_email %></small></td><td><%= formatDate(order.created_at) %></td><td><strong><%= formatCurrency(order.total_cents) %></strong></td><td><span class="status status-<%= order.status %>"><%= statusLabel(order.status) %></span></td><td><span class="status status-<%= order.payment_status %>"><%= order.payment_status %></span></td><td><form action="/admin/pedidos/<%= order.id %>" method="post" class="inline-update"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select name="status"><% ['novo','em_separacao','enviado','entregue','cancelado'].forEach((status) => { %><option value="<%= status %>" <%= order.status === status ? 'selected' : '' %>><%= statusLabel(status) %></option><% }) %></select><select name="payment_status"><% ['pendente','pago','recusado','reembolsado'].forEach((status) => { %><option value="<%= status %>" <%= order.payment_status === status ? 'selected' : '' %>><%= status %></option><% }) %></select><button type="submit">SALVAR</button></form></td></tr><% }) %><% } else { %><tr><td colspan="7" class="table-empty">Ainda não há pedidos. As vendas da loja aparecerão aqui.</td></tr><% } %></tbody></table></div></section></main><%- include('../partials/admin-end') %>
