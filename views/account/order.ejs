<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<%- include('../partials/flash') %>
<main id="main-content" class="container page-section order-detail"><a href="/conta" class="text-link">← VOLTAR PARA PEDIDOS</a><div class="order-detail-head"><div><p class="eyebrow">PEDIDO <%= order.order_number %></p><h1>SEU PEDIDO <em>NEBLK</em></h1><p><%= formatDate(order.created_at) %></p></div><div><span class="status status-<%= order.status %>"><%= statusLabel(order.status) %></span><strong><%= formatCurrency(order.total_cents) %></strong></div></div><div class="order-detail-grid"><section class="order-items-box"><h2>PEÇAS</h2><% items.forEach((item) => { %><div class="mini-order-item"><div><strong><%= item.product_name %></strong><span><%= item.size %> / <%= item.color %> · Qtd. <%= item.quantity %></span></div><strong><%= formatCurrency(item.unit_price_cents * item.quantity) %></strong></div><% }) %></section><aside class="order-info-box"><h2>PAGAMENTO</h2><p><strong><%= order.payment_method === 'pix' ? 'Pix' : 'Manual' %></strong><br><span class="status status-<%= order.payment_status %>"><%= order.payment_status.toUpperCase() %></span></p><h2>ENTREGA</h2><p><%= order.shipping_address %></p><% if (order.notes) { %><h2>OBSERVAÇÕES</h2><p><%= order.notes %></p><% } %></aside></div></main>
<%- include('../partials/footer') %>
